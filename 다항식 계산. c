/*
 * Polynomial Addition
 *
 * 배열을 이용하여 두 다항식의 계수를 저장하고,
 * 같은 차수의 계수끼리 더하여 결과 다항식을 출력한다.
 *
 * 핵심 개념
 * - 1차원 배열
 * - 배열 인덱스와 다항식 차수의 대응
 * - 삼항 연산자
 * - 반복문
 *
 * 예)
 * A(x) = 3x^2 + 2x + 1
 * B(x) = 4x + 5
 *
 * a[2] = 3, a[1] = 2, a[0] = 1
 * b[1] = 4, b[0] = 5
 *
 * 결과: 3x^2+6x+6
 */

#include <stdio.h>
#define MAX 10

int main(void)
{
    int a[MAX] = {0};
    int b[MAX] = {0};
    int c[MAX] = {0};

    int n, m;

    // 첫 번째 다항식 입력
    scanf("%d", &n);

    for (int i = n; i >= 0; i--) {
        scanf("%d", &a[i]);
    }

    // 두 번째 다항식 입력
    scanf("%d", &m);

    for (int i = m; i >= 0; i--) {
        scanf("%d", &b[i]);
    }

    // 두 다항식 중 더 높은 차수
    int l = (n > m) ? n : m;

    // 같은 차수의 계수끼리 더하기
    for (int i = l; i >= 0; i--) {
        c[i] = a[i] + b[i];
    }

    // 결과 다항식 출력
    for (int i = l; i >= 0; i--) {
        if (c[i] == 0)
            continue;

        if (i != l)
            printf("+");

        if (i == 0)
            printf("%d", c[i]);
        else if (i == 1)
            printf("%dx", c[i]);
        else
            printf("%dx^%d", c[i], i);
    }

    return 0;
}
