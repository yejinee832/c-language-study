#include <stdio.h>

/*
 * 하노이의 탑
 *
 * 재귀 함수를 이용하여 하노이의 탑 문제를 해결하고,
 * 원판의 이동 순서와 총 이동 횟수를 출력하는 프로그램이다.
 *
 * [하노이의 탑 규칙]
 * 1. 한 번에 하나의 원판만 옮길 수 있다.
 * 2. 각 기둥의 가장 위에 있는 원판만 옮길 수 있다.
 * 3. 큰 원판을 작은 원판 위에 놓을 수 없다.
 */

int count = 0;  // 원판의 총 이동 횟수

/*
 * n    : 옮길 원판의 개수
 * from : 출발 기둥
 * temp : 임시 기둥
 * to   : 도착 기둥
 */
void hanoi_tower(int n, char from, char temp, char to)
{
    /*
     * 종료 조건
     *
     * 원판이 하나만 남았다면 재귀 호출을 하지 않고
     * 출발 기둥에서 도착 기둥으로 바로 옮긴다.
     */
    if (n == 1)
    {
        count++;

        printf("[%d회] 원판 1을 %c에서 %c로 옮긴다.\n",
               count, from, to);

        return;
    }

    /*
     * 1단계
     *
     * 가장 큰 n번째 원판을 옮기기 위해
     * 그 위에 있는 n-1개의 원판을
     * 출발 기둥에서 임시 기둥으로 옮긴다.
     */
    hanoi_tower(n - 1, from, to, temp);

    /*
     * 2단계
     *
     * 가장 큰 n번째 원판을
     * 출발 기둥에서 도착 기둥으로 옮긴다.
     *
     * 이 부분에서 원판이 실제로 한 번 이동하므로
     * count를 1 증가시킨다.
     */
    count++;

    printf("[%d회] 원판 %d를 %c에서 %c로 옮긴다.\n",
           count, n, from, to);

    /*
     * 3단계
     *
     * 임시 기둥에 있는 n-1개의 원판을
     * 도착 기둥으로 옮긴다.
     *
     * 이 재귀 함수 내부에서 각각의 원판 이동에 따라
     * count가 증가하므로 여기에 count++를 추가하지 않는다.
     */
    hanoi_tower(n - 1, temp, from, to);
}

int main(void)
{
    int n;

    printf("원판의 개수를 입력하세요: ");

    if (scanf_s("%d", &n) != 1 || n < 1)
    {
        printf("1 이상의 정수를 입력해야 합니다.\n");
        return 1;
    }

    // A는 출발 기둥, B는 임시 기둥, C는 도착 기둥이다.
    hanoi_tower(n, 'A', 'B', 'C');

    printf("\n총 이동 횟수: %d회\n", count);

    return 0;
}

/*
 * [중요하게 깨달은 점 1]
 *
 * 원판 n개를 옮기는 문제를 다음 세 단계로 나눈다.
 *
 * 1. 위쪽의 n-1개 원판을 임시 기둥으로 옮긴다.
 * 2. 가장 큰 n번째 원판을 도착 기둥으로 옮긴다.
 * 3. 임시 기둥의 n-1개 원판을 도착 기둥으로 옮긴다.
 *
 * 즉, n개의 원판을 옮기는 큰 문제를
 * n-1개의 원판을 옮기는 더 작은 문제로 바꾸어 해결한다.
 *
 *
 * [중요하게 깨달은 점 2]
 *
 * count는 재귀 함수가 호출된 횟수가 아니라
 * 원판이 실제로 이동한 횟수를 나타낸다.
 *
 * 따라서 count++는 원판의 이동을 출력하는 곳에서만 실행한다.
 *
 * 재귀 호출 내부에서도 원판이 이동할 때마다 count가 증가하므로
 * 재귀 호출 앞이나 뒤에 count++를 별도로 추가하면 안 된다.
 *
 *
 * [총 이동 횟수]
 *
 * 원판이 n개일 때 필요한 최소 이동 횟수는 다음과 같다.
 *
 * 2^n - 1
 *
 * 예: 원판이 4개라면 2^4 - 1 = 15회
 */


